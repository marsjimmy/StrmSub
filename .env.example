# 复制为 .env 后填入真实值
# 射手网 ASSRT：https://assrt.net/usercp.php 获取 32 位 token
ASSRT_TOKEN=
# 飞牛影视 API 接入（Emby 式，推荐）：配了这三项就走 HTTP API，不再需要挂载 db
# URL 是飞牛影视服务的地址，通常是 http://<飞牛IP>:8005
STRMSUB_FNOS_API_URL=
STRMSUB_FNOS_API_USER=
STRMSUB_FNOS_API_PASS=
# 路径映射：飞牛侧绝对路径 -> 容器内路径，逗号分隔
# 例：/vol1/media:/media
STRMSUB_PATH_MAP=
# 飞牛影视 SQLite 直读（备选）：容器内 db 路径
# STRMSUB_FNOS_DB=/data/trimmedia.db
# OpenSubtitles：https://www.opensubtitles.com/en/consumers 新建 consumer
OS_API_KEY=
# OpenSubtitles 下载需要账号（不填则只能搜索不能下载）
OS_USER=
OS_PASS=
# SubDL：https://subdl.com/api
SUBDL_KEY=
