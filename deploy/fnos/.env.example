# StrmSub 环境变量, 与 docker-compose.yml 同目录, 文件名改成 .env
# cp .env.example .env

# ASSRT token (必填, 去 https://assrt.net/usercp.php 免费拿)
ASSRT_TOKEN=

# OpenSubtitles (可选)
OS_API_KEY=
OS_USER=
OS_PASS=

# SubDL (可选, 占位未实现)
SUBDL_KEY=

# 飞牛影视 API (可选, 也可在仪表盘 ⚙️ 设置页里配, 二选一)
# 容器里填飞牛的局域网 IP, 不要填 127.0.0.1
FNOS_API_URL=http://192.168.1.10:8005
FNOS_API_USER=
FNOS_API_PASS=

# 路径映射: 飞牛侧绝对路径 -> 容器内路径
PATH_MAP=/vol1/1000/smartstrm:/media
