# StrmSub v2 环境变量, 与 docker-compose.yml 同目录, 文件名改成 .env
# cp .env.example .env
# 以下均为首次启动播种用, 之后在设置页改 (存 SQLite)

# ASSRT token (去 https://assrt.net/usercp.php 免费拿)
ASSRT_TOKEN=

# OpenSubtitles (可选)
OS_API_KEY=
OS_USER=
OS_PASS=

# SubDL (可选)
SUBDL_KEY=

# 字幕统一保存目录 (可选, 留空=视频同目录; 填了要同步挂载 volumes)
# SUB_DIR=/subs

# FlareSolverr 地址 (可选, 用于过 Cloudflare 反爬)
# FLARESOLVERR_URL=http://192.168.1.10:8191
